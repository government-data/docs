---
// In the header, in place of Starlight's theme and language selectors: the
// app's avatar, with the same menu as in the app (who signed in, My account,
// Settings, where else to go with the account, back to the
// application, the language and sign out), plus the theme, and drawn the same
// way as the application's, so the documentation does not stand
// apart. The documentation is in the same installation (/docs/): it uses its
// session.
// The texts go in the page's language; the names of the list of applications
// (in Spanish from the account) are translated by their `kind`.
import { pathIn } from "../print/texts";

const TEXTS = {
  es: {
    account: "Mi cuenta",
    settings: "Configuración",
    applications: "Aplicaciones",
    back: "Volver a la aplicación",
    signOut: "Cerrar sesión",
    theme: "Tema",
    light: "Claro",
    dark: "Oscuro",
    auto: "Sistema",
    language: "Idioma",
    kinds: {
      management: ["Gestión", "El panel de la plataforma"],
    },
  },
  en: {
    account: "My account",
    settings: "Settings",
    applications: "Applications",
    back: "Back to the application",
    signOut: "Sign out",
    theme: "Theme",
    light: "Light",
    dark: "Dark",
    auto: "System",
    language: "Language",
    kinds: {
      management: ["Management", "The platform panel"],
    },
  },
};
const lang = Astro.locals.starlightRoute?.lang === "en" ? "en" : "es";
const t = TEXTS[lang];
// This page in each language: English at <base>…, Spanish at <base>es/….
const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
const languages = [
  { label: "Español", code: "es", href: pathIn("es", path, base) },
  { label: "English", code: "en", href: pathIn("en", path, base) },
];
// The app's line icons (18 px, stroke 1.5); the gear is the side menu's.
const ICONS = {
  account:
    '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="10" r="3"/><path d="M6.2 18.4a7 7 0 0 1 11.6 0"/>',
  back: '<path d="M7 4 3 8l4 4M3 8h14M17 12l4 4-4 4M21 16H7"/>',
  signOut: '<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/>',
};
const GEAR =
