---

<div class="profile" data-profile data-lang={lang} data-kinds={JSON.stringify(t.kinds)}>
  <button class="profile__button" type="button" aria-haspopup="true" aria-expanded="false">
    <span class="profile__avatar" data-initial>
      ·
    </span>
  </button>
  <div class="profile__menu" role="menu" hidden>
    <div class="profile__card">
      <span class="profile__avatar profile__avatar--large" data-initial>
        ·
      </span>
      <span class="profile__who">
        <strong data-name></strong>
        <span class="profile__email" data-email></span>
        <span class="profile__role" data-role></span>
      </span>
    </div>
    <div class="profile__divider"></div>
    <nav class="profile__list">
      <a class="profile__item" role="menuitem" href="/settings/account">
        <svg
          class="profile__icon"
          viewBox="0 0 24 24"
          aria-hidden="true"
          set:html={ICONS.account}
        />
        <span>{t.account}</span>
      </a>
      <a class="profile__item" role="menuitem" href="/settings">
        <svg class="profile__icon profile__icon--filled" viewBox="0 0 24 24" aria-hidden="true">
          <g transform={`translate(1 1) scale(${22 / 856}) translate(0 ${856}) scale(0.1 -0.1)`}>
            <path d={GEAR} />
          </g>
        </svg>
        <span>{t.settings}</span>
      </a>
    </nav>
    <div class="profile__apps" hidden>
      <div class="profile__divider"></div>
      <nav class="profile__list" aria-label={t.applications}>
        <span class="profile__heading">{t.applications}</span>
      </nav>
    </div>
    <div class="profile__divider"></div>
    <nav class="profile__list">
      <a class="profile__item" role="menuitem" href="/">
        <svg class="profile__icon" viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS.back} />
        <span>{t.back}</span>
      </a>
    </nav>
    <div class="profile__divider"></div>
    <div class="profile__row">
      <span>{t.theme}</span>
      <div class="profile__switch" role="group" aria-label={t.theme}>
        <button type="button" class="profile__option" data-theme-choice="light">
          {t.light}
        </button>
        <button type="button" class="profile__option" data-theme-choice="dark">
          {t.dark}
        </button>
        <button type="button" class="profile__option" data-theme-choice="auto">
          {t.auto}
        </button>
      </div>
    </div>
    <div class="profile__divider"></div>
    <div class="profile__row">
      <span>{t.language}</span>
      <div class="profile__switch" role="group" aria-label={t.language}>
        {languages.map((l) => (
          <a
            class="profile__option"
            href={l.href}
            hreflang={l.code}
            aria-current={l.code === lang ? "true" : undefined}
          >
            {l.label}
          </a>
        ))}
      </div>
    </div>
    <div class="profile__divider"></div>
    <button class="profile__item profile__signout" type="button" role="menuitem">
      <svg class="profile__icon" viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS.signOut} />
      <span>{t.signOut}</span>
    </button>
  </div>
</div>

<script>
  // Only our own addresses.
  const safe = (url: string) => url.startsWith("https://") || url.startsWith("/");

  // The theme, as Starlight keeps it: `starlight-theme` in localStorage
  // (empty: follow the system) and `data-theme` on <html>. Starlight's
  // ThemeProvider still applies the stored one before the page paints.
  type Theme = "light" | "dark" | "auto";
  const storedTheme = (): Theme => {
    const v = localStorage.getItem("starlight-theme");
    return v === "light" || v === "dark" ? v : "auto";
  };
  const systemTheme = () =>
    matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
  const applyTheme = (theme: Theme) => {
    localStorage.setItem("starlight-theme", theme === "auto" ? "" : theme);
    document.documentElement.dataset.theme = theme === "auto" ? systemTheme() : theme;
    for (const b of document.querySelectorAll<HTMLElement>("[data-theme-choice]"))
      b.setAttribute("aria-pressed", String(b.dataset.themeChoice === theme));
  };
  applyTheme(storedTheme());
  matchMedia("(prefers-color-scheme: light)").addEventListener("change", () => {
    if (storedTheme() === "auto") applyTheme("auto");
  });
  for (const b of document.querySelectorAll<HTMLElement>("[data-theme-choice]"))
    b.addEventListener("click", () => applyTheme(b.dataset.themeChoice as Theme));

  for (const root of document.querySelectorAll<HTMLElement>("[data-profile]")) {
    const kinds: Record<string, string[]> = JSON.parse(root.dataset.kinds ?? "{}");
    const button = root.querySelector<HTMLButtonElement>(".profile__button")!;
    const menu = root.querySelector<HTMLElement>(".profile__menu")!;
    const open = (yes: boolean) => {
      menu.hidden = !yes;
      button.setAttribute("aria-expanded", String(yes));
    };
    button.addEventListener("click", () => open(menu.hidden));
    document.addEventListener("click", (e) => {
      if (!root.contains(e.target as Node)) open(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") open(false);
    });

    // Who signed in: as in the app, the name (or the role), the email and
    // the role.
    fetch("/api/auth/me", { credentials: "same-origin" })
      .then((r) => (r.ok ? r.json() : null))
      .then((me) => {
        if (!me) return;
        const name = me.display_name || me.role || me.email || "";
        for (const i of root.querySelectorAll("[data-initial]"))
          i.textContent = (name || "?").charAt(0).toUpperCase();
        root.querySelector("[data-name]")!.textContent = name;
        root.querySelector("[data-email]")!.textContent = me.email || "";
        root.querySelector("[data-role]")!.textContent = me.role || "";
      })
      .catch(() => undefined);

    // Where else it can go with the account (if the installation signs in with it).
    fetch("/api/settings/account/apps", { credentials: "same-origin" })
      .then((r) => (r.ok ? r.json() : null))
      .then((d) => {
        const list = (d?.apps ?? []).filter((a: { url?: string }) => a.url && safe(a.url));
        if (!list.length) return;
        const section = root.querySelector<HTMLElement>(".profile__apps")!;
        const nav = section.querySelector<HTMLElement>("nav")!;
        for (const a of list) {
          // The name (and the detail) in the page's language.
          const [name, detail] = kinds[a.kind] ?? [];
          const url: string = a.url;
          const link = document.createElement("a");
          link.className = a.current
            ? "profile__item profile__app profile__app--current"
            : "profile__item profile__app";
          // This installation's (RustFS…) open inside the app.
          link.href = a.kind === "app" && a.id ? `/apps/${a.id}` : url;
          link.setAttribute("role", "menuitem");
          const n = document.createElement("span");
          n.textContent = name ?? a.name;
          const det = document.createElement("span");
          det.className = "profile__app-detail";
          det.textContent = detail ?? a.detail ?? "";
          const text = document.createElement("span");
          text.className = "profile__app-text";
          text.append(n, det);
          if (typeof a.icon === "string" && a.icon.startsWith("https://")) {
            // Its shape as a mask, painted with the text's colour.
            const icon = document.createElement("span");
            icon.className = "profile__app-icon";
            icon.setAttribute("aria-hidden", "true");
            icon.style.maskImage = `url("${a.icon}")`;
            link.append(icon);
          }
          link.append(text);
          nav.append(link);
        }
        section.hidden = false;
      })
      .catch(() => undefined);

    // Sign out, as in the app: the one here and, with the account, that one
    // too (its /signout goes to the site).
    root.querySelector(".profile__signout")!.addEventListener("click", async () => {
      const csrf = document.cookie
        .split("; ")
        .find((c) => c.startsWith("csrf="))
        ?.slice("csrf=".length);
      await fetch("/api/auth/logout", {
        method: "POST",
        credentials: "same-origin",
        headers: csrf ? { "x-csrf-token": csrf } : {},
      }).catch(() => undefined);
      const account = await fetch("/api/settings/account", { credentials: "same-origin" })
        .then((r) => (r.ok ? r.json() : null))
        .catch(() => null);
      const base = typeof account?.url === "string" && account.url.startsWith("https://");
      location.assign(base ? `${account.url}/signout` : "/login");
    });
  }
</script>

