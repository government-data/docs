---
// A simulation of one Government Data installation: its machines grouped by
// module, the links between them, and (in the browser) scenarios played on
// top. Drawn at build time as SVG from simulation/scene.ts, in Starlight's
// colours, so it follows the light and dark themes; its text is real text.
// The page's language comes from its path under the site's base, which is
// /docs/ in the installation and / on the public site.
import { langOf } from "../print/texts";
import { ICONS } from "./simulation/icons";
import { INSTALLATION, LINKS, NODES, VIEW, ZONES, dOf, pathOf, type Kind } from "./simulation/scene";
import { FRAME, STATES, TRAFFIC, say } from "./simulation/texts";
import "./simulation/simulation.css";

const lang = langOf(Astro.url.pathname, import.meta.env.BASE_URL);
const t = (words: { en: string; es: string }) => say(lang, words);
const id = (name: string) => `sim-${lang}-${name}`;
const kinds = [...new Set(NODES.map((n) => n.kind))] as Kind[];
const tone = (name: string) =>
  `--tone: var(--sl-color-${name}); --tone-low: var(--sl-color-${name}-low); --tone-high: var(--sl-color-${name}-high)`;
const machines = NODES.length;
---

<figure class="sim not-content" data-sim data-lang={lang}>
  <div class="sim__card">
    <p class="sim__corner sim__corner--fig">{t(FRAME.fig)}</p>
    <p class="sim__corner sim__corner--title">{t(FRAME.title)}</p>

    <div class="sim__stage">
      <svg viewBox={`0 0 ${VIEW.w} ${VIEW.h}`} role="img" aria-label={t(FRAME.aria)} font-family="var(--sl-font)">
        <defs>
          <filter id={id("halo")} x="-20%" y="-40%" width="140%" height="190%">
            <feGaussianBlur stdDeviation="3" />
          </filter>
          {kinds.map((k) => <symbol id={id(`ic-${k}`)} viewBox="0 0 24 24" set:html={ICONS[k]} />)}
        </defs>

        <path class="sim__installation" d={INSTALLATION} />
        <text class="sim__frame-label" x="26" y="92">{t(FRAME.installation)}</text>

        {ZONES.map((z) => (
          <g class="sim__zone" style={tone(z.tone)}>
            <rect x={z.x} y={z.y} width={z.w} height={z.h} rx="12" />
            {[[z.x + 6, z.y + 6], [z.x + z.w - 6, z.y + 6], [z.x + 6, z.y + z.h - 6], [z.x + z.w - 6, z.y + z.h - 6]].map(([cx, cy]) => (
              <circle class="sim__screw" cx={cx} cy={cy} r="1.3" />
            ))}
            <text class="sim__zone-label" x={z.x + 14} y={z.labelAt ? z.y + z.h - 7 : z.y + 16}>{t(z.label)}</text>
          </g>
        ))}

        <g class="sim__links">
          {LINKS.map((l) => {
            const path = pathOf(l);
            const [a, b] = [path[0], path[path.length - 1]];
            return (
              <g class={`sim__link sim__link--${l.kind}`}>
                <path d={dOf(path)} />
                <circle cx={a[0]} cy={a[1]} r="2.2" />
                <circle cx={b[0]} cy={b[1]} r="2.2" />
              </g>
            );
          })}
        </g>

        <g data-trails></g>

        <g class="sim__nodes">
          {NODES.map((n) => {
            const [left, top] = [n.x - n.w / 2, n.y - n.h / 2];
            const tall = n.h >= 90;
            const tile: [number, number] = tall ? [left + 9, top + 9] : [left + 7, n.y - 12];
            const tx = tall ? left + 9 : left + 38;
            const ty = tall ? top + 52 : n.y + (n.lines.length ? -2 : 5);
            return (
              <g class="sim__node" data-node={n.id} data-state={n.state ?? "up"} data-x={n.x} data-y={n.y}>
                <rect class="sim__halo" x={left + 2} y={top + 5} width={n.w} height={n.h} rx="9" filter={`url(#${id("halo")})`} />
                <rect class="sim__lip" x={left} y={top + 3} width={n.w} height={n.h} rx="9" />
                <rect class="sim__face" x={left} y={top} width={n.w} height={n.h} rx="9" />
                <path class="sim__bevel" d={`M${left + 9} ${top + 1} H${left + n.w - 9}`} />
                <rect class="sim__tile" x={tile[0]} y={tile[1]} width="24" height="24" rx="6.5" />
                <use class="sim__kind" href={`#${id(`ic-${n.kind}`)}`} x={tile[0] + 4} y={tile[1] + 4} width="16" height="16" />
                <text class="sim__badge" x={tile[0] + 25} y={tile[1] + 4} text-anchor="middle" data-badge />
                <text class="sim__title" x={tx} y={ty}>{t(n.title)}</text>
                {n.lines.map((line, k) => (
                  <text class="sim__line" x={tx} y={tall ? ty + 18 + k * 16 : ty + 14} data-line={line.key}>
                    {t(line.text)}
                  </text>
                ))}
              </g>
            );
          })}
        </g>

        <g data-packets></g>
      </svg>
    </div>

    <p class="sim__corner sim__corner--hint" data-hint>{t(FRAME.hint)}</p>
    <p class="sim__corner sim__corner--readout" data-readout aria-hidden="true">
      {t(FRAME.ready)} · {machines}
    </p>
  </div>

  <div class="sim__legend">
    <ul>
      {TRAFFIC.map(([kind, words]) => (
        <li>
          <svg viewBox="0 0 34 10" aria-hidden="true" class={`sim__link sim__link--${kind}`}>
            <path d="M3 5 H31" />
            <circle cx="3" cy="5" r="2.2" />
            <circle cx="31" cy="5" r="2.2" />
          </svg>
          {t(words)}
        </li>
      ))}
    </ul>
    <ul>
      {STATES.map(([state, badge, words]) => (
        <li>
          <span class="sim__swatch" data-state={state}>{badge}</span>
          {t(words)}
        </li>
      ))}
    </ul>
  </div>
</figure>
